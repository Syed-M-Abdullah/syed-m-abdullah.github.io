# Contact API (server/) — copy this file to .env and fill in the values.
# .env is git-ignored. Never commit real credentials.

# Gmail account that sends the emails, and a Google *app password* for it
# (Google Account → Security → 2-Step Verification → App passwords). Not your normal password.
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where new-lead alerts go (comma-separate several addresses if you like).
NOTIFY_TO=you@gmail.com

# Optional
# PORT=8787
# Browser origins allowed to call the API (localhost is always allowed for development).
# ALLOWED_ORIGINS=https://syed-m-abdullah.github.io

# Frontend (optional): point the site at a specific contact API while developing.
# Without it, `npm run dev` uses http://localhost:8787/api/contact.
# VITE_CONTACT_API_URL=http://localhost:8787/api/contact
