          ]
        }
      ]
    },
    {
      "heading": "Cold Leads",
      "blocks": [
        {
          "list": [
            "Adds the lead to a long term nurture campaign",
            "Sends scheduled educational content",
            "Moves the lead back into sales when engagement increases"
          ]
        }
      ]
    },
    {
      "heading": "Enterprise Leads",
      "blocks": [
        {
          "list": [
            "Creates a high priority opportunity",
