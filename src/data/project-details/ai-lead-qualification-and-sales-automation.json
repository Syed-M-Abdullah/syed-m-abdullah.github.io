            "Sends a personalized email",
            "Notifies the sales team in Slack",
            "Provides a booking option",
            "Creates a sales follow up task"
          ]
        }
      ]
    },
    {
      "heading": "Warm Leads",
      "blocks": [
        {
          "list": [
            "Adds the lead to a nurture campaign",
            "Sends targeted follow up emails",
            "Tracks engagement",
