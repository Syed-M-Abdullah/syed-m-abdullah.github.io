  "overview": [],
  "sections": [
    {
      "heading": "Ticket Management",
      "blocks": [
        {
          "p": "The workflow:"
        },
        {
          "list": [
            "Receives requests through email, forms, or chat",
            "Creates a Zendesk ticket",
            "Analyzes the ticket details",
            "Identifies the issue category and urgency",
            "Determines customer type and required department",
            "Routes the ticket to the appropriate support workflow"
          ]
        }
      ]
    },
    {
      "heading": "Smart Routing",
      "blocks": [
        {
          "p": "The system routes tickets based on their conditions:"
        },
        {
          "list": [
            "Critical issues → Senior Support + Slack Alert",
            "Billing issues → Finance Team",
            "Technical issues → Technical Support",
            "General questions → Automated Response",
            "VIP customers → Priority Handling"
          ]
        }
      ]
    },
    {
      "heading": "AI Ticket Analysis",
      "blocks": [
        {
          "p": "Each ticket is evaluated for:"
        },
        {
          "list": [
            "Issue category",
            "Urgency",
            "Customer type",
            "Product or service",
            "Sentiment",
            "Required department"
          ]
        }
      ]
    },
    {
      "heading": "Customer Responses",
      "blocks": [
        {
          "p": "For simple requests:"
        },
        {
          "list": [
            "Generates a response",
            "Sends the response to the customer",
            "Updates the ticket"
          ]
        },
        {
          "p": "For complex requests:"
        },
        {
          "list": [
            "Creates a response draft",
            "Sends it to a support agent for review",
            "Waits for the agent to handle the case"
          ]
        }
      ]
    },
    {
      "heading": "SLA Monitoring",
      "blocks": [
        {
          "p": "The workflow checks whether tickets are handled within the required timeframe."
        },
        {
          "p": "Example:"
        }
      ]
    },
    {
      "heading": "Ticket Created → Wait 2 Hours → Check Status → Resolved / Escalate",
      "blocks": [
        {
          "p": "Unresolved tickets trigger an internal Slack alert and escalation."
        }
      ]
    },
    {
      "heading": "Sentiment Escalation",
      "blocks": [
        {
          "p": "If a ticket is marked as highly negative and belongs to a VIP customer:"
        },
        {
          "list": [
            "Escalates the ticket immediately",
            "Notifies the support manager",
            "Prioritizes the case for review"
          ]
        }
      ]
    },
    {
      "heading": "Resolution & Follow-Up",
      "blocks": [
        {
          "p": "When a customer responds:"
        },
        {
          "list": [
            "Reanalyzes the latest message",
            "Checks whether the issue is resolved",
            "Closes resolved tickets",
            "Escalates unresolved cases",
            "Sends a customer satisfaction survey"
          ]
        }
      ]
    },
    {
      "heading": "Reporting",
      "blocks": [
        {
          "p": "Resolved tickets are recorded with:"
        },
        {
          "list": ["Customer", "Category", "Priority", "Resolution time", "Sentiment", "CSAT score"]
        }
      ]
    }
  ],
  "result": [
    "A complete customer support workflow that connects ticket management, automated responses, smart routing, SLA monitoring, escalation, resolution, and customer satisfaction tracking into one system."
  ],
