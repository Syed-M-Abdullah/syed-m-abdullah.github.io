{
  "name": "portfolio-contact-api",
  "private": true,
  "description": "Contact form API for the portfolio: Express + Nodemailer over Gmail SMTP.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env index.js",
    "dev": "node --watch --env-file-if-exists=../.env index.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "nodemailer": "10.0.13"
  }
}
